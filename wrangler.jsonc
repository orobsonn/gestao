{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestao",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestao-db",
      "database_id": "dd58c125-2a8f-406c-8aa6-bef02027d0e9",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FLUE_GESTAO_BOT_AGENT",
        "class_name": "FlueGestaoBotAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2",
      "new_sqlite_classes": ["FlueRegistry", "FlueGestaoBotAgent"]
    }
  ]
}
