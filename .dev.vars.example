# Claude Harness — "strong eyes, cheap hands" dispatch runner.
# Copy this file to .dev.vars (gitignored) and set the token below.
# Ollama auth token used by `claude -p` with ANTHROPIC_BASE_URL=https://ollama.com.
# NEVER commit the real value — .dev.vars must stay out of git.
ANTHROPIC_AUTH_TOKEN=

# Platform bootstrap super-admin (Worker secrets — never wrangler.jsonc vars).
# Leave empty in the example; set real values only in gitignored .dev.vars.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Per-tenant LLM API key encryption at rest (Worker secret — never wrangler vars).
LLM_KEY_ENCRYPTION_SECRET=

# Single app-level Telegram bot (Worker secrets — never wrangler.jsonc vars).
# Leave empty in the example; set real values only in gitignored .dev.vars.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
