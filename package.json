{
  "name": "gestao",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && npx flue build --target cloudflare && wrangler deploy --config dist/gestao/wrangler.json",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply gestao-db --local",
    "db:migrate": "wrangler d1 migrations apply gestao-db --remote",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prod": "E2E_BASE_URL=https://gestao.robsonlins.workers.dev playwright test",
    "e2e:seed": "node scripts/e2e-seed.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "hono": "^4.10.7",
    "lucide-react": "^0.525.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.10.1",
    "recharts": "2.15.4",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.13",
    "@flue/runtime": "1.0.0-beta.9",
    "@flue/cli": "1.0.0-beta.9",
    "agents": "0.14.5",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.15.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "wrangler": "^4.70.0"
  }
}
